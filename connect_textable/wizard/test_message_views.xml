<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connect_textable_test_message_form" model="ir.ui.view">
        <field name="name">connect.textable.test.message.form</field>
        <field name="model">connect.textable.test.message</field>
        <field name="arch" type="xml">
            <form string="Send Textable Test Message">
                <div class="alert alert-warning" role="alert">
                    This sends one real SMS through the same gate as any other send.
                </div>
                <group>
                    <field name="number_id"/>
                    <field name="recipient" placeholder="+13125550123"/>
                    <field name="body"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Send" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_connect_textable_test_message" model="ir.actions.act_window">
        <field name="name">Send Textable Test Message</field>
        <field name="res_model">connect.textable.test.message</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
