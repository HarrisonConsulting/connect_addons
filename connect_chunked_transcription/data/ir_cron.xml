<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!-- Watchdog: reset chunks stuck in 'in_progress' for too long so they
         can be retried by queue_job. Happens when a worker crashes mid-call. -->
    <record id="cron_watchdog_stuck_chunks" model="ir.cron">
        <field name="name">Connect Chunked Transcription: Reset Stuck Chunks</field>
        <field name="model_id" ref="model_connect_transcription_chunk"/>
        <field name="state">code</field>
        <field name="code">model._cron_watchdog_stuck_chunks()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
