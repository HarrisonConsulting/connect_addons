<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend connect.voice.agent form to add custom LLM fields -->
    <record id="view_connect_voice_agent_form_openai" model="ir.ui.view">
        <field name="name">connect.voice.agent.form.openai</field>
        <field name="model">connect.voice.agent</field>
        <field name="inherit_id" ref="connect_voice.view_connect_voice_agent_form"/>
        <field name="arch" type="xml">
            <!-- Add custom_llm_model_id field after llm_model -->
            <field name="llm_model" position="after">
                <field name="custom_llm_model_id"
                       invisible="llm_model != 'custom-llm'"
                       required="llm_model == 'custom-llm'"
                       options="{'no_create': True}"/>
            </field>

            <!-- Add Custom LLM Settings group after max_tokens -->
            <field name="max_tokens" position="after">
                <field name="custom_llm_extra_body"
                       string="Extra Body (JSON)"
                       invisible="llm_model != 'custom-llm'"
                       placeholder='{"user_id": "123", "custom_param": "value"}'/>
            </field>
        </field>
    </record>

</odoo>
