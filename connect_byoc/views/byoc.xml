<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="byoc_action" model="ir.actions.act_window">
        <field name="name">BYOC</field>
        <field name="path">byoc-carriers</field>
        <field name="res_model">connect.byoc</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_connect_byoc"
            sequence="210"
            parent="connect.menu_connect_settings"
            name="BYOC"/>

    <menuitem id="byocs_menu"
            sequence="10"
            parent="menu_connect_byoc"
            name="Carriers"
            action="byoc_action"/>

    <record id="byoc_list" model="ir.ui.view">
        <field name="name">connect.byoc_list</field>
        <field name="model">connect.byoc</field>
        <field name="arch" type="xml">
            <list>
                <field name="friendly_name"/>
                <field name="origination_uris" widget="many2many_tags"/>
                <field name="default_callerid" string="CallerID"/>
                <field name="app"/>
                <field name="domain_name" string="Domain"/>
            </list>
        </field>
    </record>

    <record id="byoc_form" model="ir.ui.view">
        <field name="name">connect.byoc_form</field>
        <field name="model">connect.byoc</field>
        <field name="arch" type="xml">
            <form string="BYOC">
                <sheet>
                    <field name="id" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="friendly_name" placeholder="Carrier name..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Trunk">
                            <field name="app"/>
                            <field name="default_callerid"/>
                            <field name="cnam_lookup_enabled"/>
                            <field name="domain_name" string="Domain" invisible="id == False"/>
                        </group>
                        <group string="SIP credentials" invisible="id == False">
                            <field name="sip_username" required="id != False"/>
                            <field name="sip_password" password="True" required="id != False"/>
                        </group>
                    </group>
                    <group string="Origination" invisible="id == False">
                        <field name="origination_uris" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="target" placeholder="sip:your.siptrunk.com:5060"/>
                                <field name="priority"/>
                                <field name="weight"/>
                                <field name="enabled"/>
                            </list>
                        </field>
                    </group>
                    <notebook>
                        <page name="reference" string="Reference" groups="base.group_no_one" invisible="id == False">
                            <group>
                                <field name="sid"/>
                                <field name="connection_policy_sid"/>
                                <field name="sip_credential_sid"/>
                                <field name="voice_url"/>
                                <field name="voice_fallback_url"/>
                                <field name="voice_status_url"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="connect_byoc_search" model="ir.ui.view" >
        <field name="name">connect_byoc_search</field>
        <field name="model">connect.byoc</field>
        <field name="arch" type="xml">
            <search>
                <field name="friendly_name"/>
            </search>
        </field>
    </record>

</odoo>