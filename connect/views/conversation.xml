<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_connect_conversation" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="path">connect-conversations</field>
        <field name="res_model">connect.conversation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="connect_conversation_menu"
              name="Conversations"
              action="action_connect_conversation"
              sequence="60"
              parent="connect.connect_messaging_menu"/>

    <!-- Search View -->
    <record id="view_connect_conversation_search" model="ir.ui.view">
        <field name="name">connect.conversation.search</field>
        <field name="model">connect.conversation</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" string="Contact"/>
                <field name="phone_b" string="Number" filter_domain="[('phone_b', 'ilike', self)]"/>
                <field name="last_message_body" string="Message" filter_domain="[('last_message_body', 'ilike', self)]"/>
                <separator/>
                <filter string="SMS" name="sms" domain="[('channel_type', '=', 'sms')]"/>
                <filter string="WhatsApp" name="whatsapp" domain="[('channel_type', '=', 'whatsapp')]"/>
                <separator/>
                <filter string="Has Error" name="has_error" domain="[('has_error', '=', True)]"/>
                <separator/>
                <filter string="Today" name="today" domain="[('last_message_date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Last 7 Days" name="last_7_days" domain="[('last_message_date', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter string="Contact" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Channel" name="group_channel" context="{'group_by': 'channel_type'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'last_message_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List View -->
    <record id="view_connect_conversation_list" model="ir.ui.view">
        <field name="name">connect.conversation.list</field>
        <field name="model">connect.conversation</field>
        <field name="arch" type="xml">
            <list decoration-danger="has_error" default_order="last_message_date desc">
                <field name="has_error" invisible="1"/>
                <field name="partner_id" widget="many2one_avatar" string="Contact"/>
                <field name="phone_b" string="Number" widget="phone"/>
                <field name="channel_type" string="Channel"/>
                <field name="last_message_body" string="Last Message"/>
                <field name="last_message_date" string="Date"/>
                <field name="message_count" string="Messages"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_connect_conversation_form" model="ir.ui.view">
        <field name="name">connect.conversation.form</field>
        <field name="model">connect.conversation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="phone_b" string="Their Number" widget="phone"/>
                            <field name="channel_type"/>
                        </group>
                        <group>
                            <field name="phone_a" string="Our Number" widget="phone"/>
                            <field name="message_count" readonly="1"/>
                            <field name="last_message_date" readonly="1"/>
                        </group>
                    </group>
                    <field name="message_ids" widget="connect_chat_thread"/>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
