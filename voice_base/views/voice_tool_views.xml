<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Voice Tool List View -->
    <record id="view_voice_tool_list" model="ir.ui.view">
        <field name="name">voice.tool.list</field>
        <field name="model">voice.tool</field>
        <field name="arch" type="xml">
            <list string="Voice Tools">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="tool_type"/>
                <field name="parameter_count"/>
                <field name="usage_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Voice Tool Form View -->
    <record id="view_voice_tool_form" model="ir.ui.view">
        <field name="name">voice.tool.form</field>
        <field name="model">voice.tool</field>
        <field name="arch" type="xml">
            <form string="Voice Tool">
                <header>
                    <button name="action_test_tool" type="object" string="Test Tool" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tool_type"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="usage_count"/>
                            <field name="error_count"/>
                            <field name="last_used"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Describe what this tool does (shown to LLM)"/>
                    </group>

                    <notebook>
                        <page string="Configuration" name="config">
                            <!-- Webhook Configuration -->
                            <group invisible="tool_type != 'webhook'" string="Webhook Configuration">
                                <group>
                                    <field name="webhook_url" placeholder="https://api.example.com/endpoint"/>
                                    <field name="webhook_method"/>
                                    <field name="timeout_seconds"/>
                                </group>
                                <group>
                                    <field name="webhook_headers" placeholder='{"X-Custom-Header": "value"}'/>
                                </group>
                            </group>

                            <!-- Webhook Authentication -->
                            <group invisible="tool_type != 'webhook'" string="Authentication">
                                <group>
                                    <field name="webhook_auth_type"/>
                                </group>
                                <group invisible="webhook_auth_type == 'none'">
                                    <field name="webhook_auth_token" password="True"
                                           invisible="webhook_auth_type not in ('bearer', 'basic', 'oauth2_client_credentials')"/>
                                    <field name="webhook_auth_username"
                                           invisible="webhook_auth_type not in ('basic', 'oauth2_client_credentials')"/>
                                </group>
                            </group>

                            <!-- OAuth2 Configuration -->
                            <group invisible="webhook_auth_type not in ('oauth2_client_credentials', 'oauth2_jwt')" string="OAuth2 Settings">
                                <group>
                                    <field name="webhook_oauth2_token_url" placeholder="https://oauth.example.com/token"/>
                                    <field name="webhook_oauth2_scopes" placeholder="read,write"/>
                                </group>
                                <group invisible="webhook_auth_type != 'oauth2_client_credentials'">
                                    <field name="webhook_oauth2_extra_params" placeholder='{"custom_param": "value"}'/>
                                </group>
                            </group>

                            <!-- JWT Configuration -->
                            <group invisible="webhook_auth_type != 'oauth2_jwt'" string="JWT Settings">
                                <group>
                                    <field name="webhook_jwt_secret" password="True"/>
                                    <field name="webhook_jwt_algorithm"/>
                                </group>
                                <group>
                                    <field name="webhook_jwt_issuer"/>
                                    <field name="webhook_jwt_audience"/>
                                    <field name="webhook_jwt_subject"/>
                                </group>
                            </group>

                            <!-- Client Tool Configuration -->
                            <group invisible="tool_type != 'client'" string="Client Configuration">
                                <group>
                                    <field name="wait_for_response"/>
                                    <field name="client_timeout_seconds"/>
                                </group>
                            </group>

                            <!-- System Tool Configuration -->
                            <group invisible="tool_type != 'system'" string="System Configuration">
                                <group>
                                    <field name="system_tool_type"/>
                                </group>
                            </group>

                            <!-- Transfer Call Configuration (Phone or Agent) -->
                            <group invisible="system_tool_type != 'transfer_call'" string="Transfer Settings">
                                <group>
                                    <field name="transfer_destination_type"/>
                                    <field name="transfer_destination" placeholder="+1234567890 or Agent ID"/>
                                </group>
                                <group invisible="transfer_destination_type == 'agent'">
                                    <field name="transfer_message_caller" placeholder="Please hold while I transfer you..."/>
                                    <field name="transfer_message_recipient" placeholder="Incoming transfer from AI agent..."/>
                                </group>
                            </group>

                            <!-- Voicemail Detection Configuration -->
                            <group invisible="system_tool_type != 'detect_voicemail'" string="Voicemail Settings">
                                <group>
                                    <field name="voicemail_action"/>
                                </group>
                                <group invisible="voicemail_action != 'leave_message'">
                                    <field name="voicemail_message" placeholder="Hi, this is a message from..."/>
                                </group>
                            </group>

                            <!-- Tone Configuration (DTMF) -->
                            <group invisible="system_tool_type != 'play_tones'" string="Tone Settings">
                                <group>
                                    <field name="tone_sequence" placeholder="123#w456"/>
                                    <field name="tone_out_of_band"/>
                                </group>
                            </group>
                        </page>

                        <page string="Speech &amp; Sound" name="speech">
                            <group string="Pre-Tool Message">
                                <group>
                                    <field name="force_pre_tool_message"/>
                                </group>
                                <group>
                                    <field name="pre_tool_message" placeholder="Let me check that for you..."/>
                                </group>
                            </group>
                            <group string="Execution Sound">
                                <group>
                                    <field name="execution_sound"/>
                                    <field name="execution_sound_behavior" invisible="execution_sound == 'none'"/>
                                </group>
                            </group>
                        </page>

                        <page string="Parameters" name="parameters">
                            <field name="parameter_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="parameter_type"/>
                                    <field name="required"/>
                                    <field name="description"/>
                                    <field name="default_value"/>
                                    <field name="enum_values"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Voice Tool Search View -->
    <record id="view_voice_tool_search" model="ir.ui.view">
        <field name="name">voice.tool.search</field>
        <field name="model">voice.tool</field>
        <field name="arch" type="xml">
            <search string="Voice Tools">
                <field name="name"/>
                <field name="description"/>
                <filter string="Webhook" name="filter_webhook" domain="[('tool_type', '=', 'webhook')]"/>
                <filter string="Client" name="filter_client" domain="[('tool_type', '=', 'client')]"/>
                <filter string="System" name="filter_system" domain="[('tool_type', '=', 'system')]"/>
                <separator/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Tool Type" name="group_tool_type" context="{'group_by': 'tool_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Voice Tool Action -->
    <record id="action_voice_tool" model="ir.actions.act_window">
        <field name="name">Tools</field>
        <field name="path">voice-tools</field>
        <field name="res_model">voice.tool</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first voice tool
            </p>
            <p>
                Tools allow voice agents to perform actions like making API calls,
                transferring calls, or executing system functions.
            </p>
        </field>
    </record>

</odoo>
