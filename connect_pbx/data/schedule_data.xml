<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Monday-Friday: 9:00-17:00 -->
    <record id="schedule_line_monday" model="connect.schedule.line">
        <field name="schedule_id" ref="connect.schedule_us_business_hours"/>
        <field name="day_of_week">0</field>
        <field name="start_hour">9.0</field>
        <field name="end_hour">17.0</field>
    </record>
    <record id="schedule_line_tuesday" model="connect.schedule.line">
        <field name="schedule_id" ref="connect.schedule_us_business_hours"/>
        <field name="day_of_week">1</field>
        <field name="start_hour">9.0</field>
        <field name="end_hour">17.0</field>
    </record>
    <record id="schedule_line_wednesday" model="connect.schedule.line">
        <field name="schedule_id" ref="connect.schedule_us_business_hours"/>
        <field name="day_of_week">2</field>
        <field name="start_hour">9.0</field>
        <field name="end_hour">17.0</field>
    </record>
    <record id="schedule_line_thursday" model="connect.schedule.line">
        <field name="schedule_id" ref="connect.schedule_us_business_hours"/>
        <field name="day_of_week">3</field>
        <field name="start_hour">9.0</field>
        <field name="end_hour">17.0</field>
    </record>
    <record id="schedule_line_friday" model="connect.schedule.line">
        <field name="schedule_id" ref="connect.schedule_us_business_hours"/>
        <field name="day_of_week">4</field>
        <field name="start_hour">9.0</field>
        <field name="end_hour">17.0</field>
    </record>

    <!-- Saturday-Sunday: closed -->
    <record id="schedule_line_saturday" model="connect.schedule.line">
        <field name="schedule_id" ref="connect.schedule_us_business_hours"/>
        <field name="day_of_week">5</field>
        <field name="is_closed" eval="True"/>
    </record>
    <record id="schedule_line_sunday" model="connect.schedule.line">
        <field name="schedule_id" ref="connect.schedule_us_business_hours"/>
        <field name="day_of_week">6</field>
        <field name="is_closed" eval="True"/>
    </record>

    <!-- Common US Holidays (recurring) -->
    <record id="schedule_holiday_new_year" model="connect.schedule.holiday">
        <field name="schedule_id" ref="connect.schedule_us_business_hours"/>
        <field name="name">New Year's Day</field>
        <field name="date">2026-01-01</field>
        <field name="recurring" eval="True"/>
    </record>
    <record id="schedule_holiday_independence_day" model="connect.schedule.holiday">
        <field name="schedule_id" ref="connect.schedule_us_business_hours"/>
        <field name="name">Independence Day</field>
        <field name="date">2026-07-04</field>
        <field name="recurring" eval="True"/>
    </record>
    <record id="schedule_holiday_christmas" model="connect.schedule.holiday">
        <field name="schedule_id" ref="connect.schedule_us_business_hours"/>
        <field name="name">Christmas Day</field>
        <field name="date">2026-12-25</field>
        <field name="recurring" eval="True"/>
    </record>

    <!-- Floating holidays (non-recurring, specific dates for 2026) -->
    <record id="schedule_holiday_memorial_day" model="connect.schedule.holiday">
        <field name="schedule_id" ref="connect.schedule_us_business_hours"/>
        <field name="name">Memorial Day</field>
        <field name="date">2026-05-25</field>
        <field name="recurring" eval="False"/>
    </record>
    <record id="schedule_holiday_labor_day" model="connect.schedule.holiday">
        <field name="schedule_id" ref="connect.schedule_us_business_hours"/>
        <field name="name">Labor Day</field>
        <field name="date">2026-09-07</field>
        <field name="recurring" eval="False"/>
    </record>
    <record id="schedule_holiday_thanksgiving" model="connect.schedule.holiday">
        <field name="schedule_id" ref="connect.schedule_us_business_hours"/>
        <field name="name">Thanksgiving</field>
        <field name="date">2026-11-26</field>
        <field name="recurring" eval="False"/>
    </record>


</odoo>
