<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connect_recording_tree" model="ir.ui.view">
        <field name="name">connect.recording.tree</field>
        <field name="model">connect.recording</field>
        <field name="arch" type="xml">
            <list default_order="id desc" decoration-danger="transcription_error">
                <field name="transcription_error" column_invisible="1"/>
                <field name="call"/>
                <field name="partner" optional="show"/>
                <field name="caller_number"/>
                <field name="called_number"/>
                <field name="users" widget="many2many_tags" optional="show"/>
                <field name="duration_human" string="Duration"/>
                <field name="list_view_summary" string="Summary"/>
                <field name="create_date" string="Date"/>
            </list>
        </field>
    </record>

    <record id="view_connect_recording_form" model="ir.ui.view">
        <field name="name">connect.recording.form</field>
        <field name="model">connect.recording</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="get_transcript" type="object" string="Transcribe"
                            class="btn-primary"
                            invisible="(transcript and not transcription_error) or (not media_url and not recording_attachment)"/>
                    <field name="status" widget="badge" invisible="not status"/>
                </header>
                <sheet>
                    <field name="media_url" invisible="1"/>
                    <field name="recording_attachment" invisible="1"/>
                    <group>
                        <group>
                            <field name="call"/>
                            <field name="partner"/>
                            <field name="caller_user" invisible="not caller_user"/>
                            <field name="caller_number" widget="phone"/>
                        </group>
                        <group>
                            <field name="called_user" invisible="not called_user"/>
                            <field name="called_number" widget="phone"/>
                            <field name="duration_human" string="Duration"/>
                        </group>
                    </group>
                    <field name="summary" nolabel="1" invisible="not summary"/>
                    <group string="Recording" invisible="not recording_widget">
                        <field name="recording_widget" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <page name="transcript" string="Transcript" invisible="not transcript">
                            <field name="transcript" nolabel="1"/>
                        </page>
                        <page name="details" string="Details">
                            <group>
                                <group>
                                    <field name="start_time"/>
                                    <field name="duration" string="Seconds"/>
                                    <field name="channel" invisible="not channel"/>
                                    <field name="source" invisible="not source"/>
                                    <field name="redaction_note" invisible="not redaction_note"/>
                                </group>
                                <group string="Price" groups="connect.group_admin">
                                    <field name="price"/>
                                    <field name="price_unit"/>
                                    <field name="transcription_price"/>
                                </group>
                            </group>
                        </page>
                        <page name="reference" string="Reference" groups="base.group_no_one">
                            <group>
                                <field name="sid"/>
                                <field name="call_sid"/>
                                <field name="media_url"/>
                                <field name="recording_filename" invisible="not recording_filename"/>
                                <field name="transcription_token" invisible="not transcription_token"/>
                            </group>
                        </page>
                        <page name="error" string="Error" invisible="not transcription_error">
                            <group>
                                <field name="transcription_error" string="What happened"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_connect_recording_search" model="ir.ui.view">
        <field name="name">connect.recording.search</field>
        <field name="model">connect.recording</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner"/>
                <field name="caller_user"/>
                <field name="called_user"/>
                <field name="caller_number"/>
                <field name="called_number"/>
                <field name="summary"/>
                <filter name="partners" string="Partners" domain="[('partner', '!=', False)]"/>
                <filter name="transcription_failed" string="Transcription failed"
                        domain="[('transcription_error', '!=', False)]"/>
                <group>
                    <filter name="by_partner" string="Partner" context="{'group_by': 'partner'}"/>
                    <filter name="by_caller" string="Caller User" context="{'group_by': 'caller_user'}"/>
                    <filter name="by_called" string="Called User" context="{'group_by': 'called_user'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_connect_recording" model="ir.actions.act_window">
        <field name="name">Recordings</field>
        <field name="res_model">connect.recording</field>
        <field name="view_mode">list,form</field>
        <field name="path">connect-recording</field>
    </record>

    <menuitem id="menu_connect_recordings"
              name="Recordings"
              parent="menu_connect_calls"
              action="action_connect_recording"
              sequence="20"/>
</odoo>
