<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ElevenLabs Provider Tree View -->
    <record id="view_voice_provider_elevenlabs_tree" model="ir.ui.view">
        <field name="name">voice.provider.elevenlabs.tree</field>
        <field name="model">voice.provider.elevenlabs</field>
        <field name="arch" type="xml">
            <list string="ElevenLabs Providers">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="provider_type" column_invisible="1"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="agent_count"/>
                <field name="conversation_count"/>
                <field name="last_used"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ElevenLabs Provider Form View -->
    <record id="view_voice_provider_elevenlabs_form" model="ir.ui.view">
        <field name="name">voice.provider.elevenlabs.form</field>
        <field name="model">voice.provider.elevenlabs</field>
        <field name="arch" type="xml">
            <form string="ElevenLabs Provider">
                <header>
                    <button name="action_test_connection"
                            type="object"
                            string="Test Connection"
                            class="btn-primary"
                            help="Test API connection"/>
                    <button name="action_sync_voices"
                            type="object"
                            string="Sync Voices"
                            class="btn-secondary"
                            help="Sync available voices from ElevenLabs"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{&quot;terminology&quot;: &quot;archive&quot;}"/>
                        </button>
                    </div>
                    <group>
                        <group name="basic_info">
                            <field name="name" placeholder="e.g., ElevenLabs Production"/>
                            <field name="provider_type" readonly="1"/>
                            <field name="sequence"/>
                            <field name="is_default"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group name="api_config">
                            <field name="api_key" password="True" placeholder="Your ElevenLabs API key"/>
                            <field name="api_endpoint" placeholder="https://api.elevenlabs.io (optional)"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Configuration" name="config">
                            <group>
                                <group string="Default Settings" name="defaults">
                                    <field name="default_tts_model"/>
                                    <field name="default_llm_model"/>
                                </group>
                                <group string="Webhooks" name="webhooks">
                                    <field name="webhook_secret" password="True"/>
                                </group>
                            </group>
                        </page>
                        <page string="Capabilities" name="capabilities">
                            <group>
                                <group>
                                    <field name="supports_tools" readonly="1"/>
                                    <field name="supports_mcp" readonly="1"/>
                                    <field name="supports_knowledge_base" readonly="1"/>
                                    <field name="supports_voice_library" readonly="1"/>
                                </group>
                                <group>
                                    <field name="supports_voice_cloning" readonly="1"/>
                                    <field name="supports_telephony" readonly="1"/>
                                    <field name="supports_phone_registration" readonly="1"/>
                                    <field name="supports_on_premise" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Statistics" name="stats">
                            <group>
                                <group>
                                    <field name="agent_count" readonly="1"/>
                                    <field name="conversation_count" readonly="1"/>
                                </group>
                                <group>
                                    <field name="last_used" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ElevenLabs Provider Action -->
    <record id="action_voice_provider_elevenlabs" model="ir.actions.act_window">
        <field name="name">ElevenLabs Providers</field>
        <field name="res_model">voice.provider.elevenlabs</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first ElevenLabs provider
            </p>
            <p>
                Configure ElevenLabs API credentials to enable voice AI capabilities.
            </p>
        </field>
    </record>
</odoo>
