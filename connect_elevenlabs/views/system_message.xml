<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- System Message Tree View -->
    <record id="elevenlabs_system_message_tree" model="ir.ui.view">
        <field name="name">elevenlabs_system_message_tree</field>
        <field name="model">connect.elevenlabs_system_message</field>
        <field name="arch" type="xml">
            <list>
                <field name="message_key"/>
                <field name="text"/>
                <field name="preview_audio" widget="html"/>
            </list>
        </field>
    </record>

    <!-- System Message Form View -->
    <record id="elevenlabs_system_message_form" model="ir.ui.view">
        <field name="name">elevenlabs_system_message_form</field>
        <field name="model">connect.elevenlabs_system_message</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="message_key"/>
                        <field name="text"/>
                        <field name="preview_audio" widget="html" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- System Message Action -->
    <record id="elevenlabs_system_message_action" model="ir.actions.act_window">
        <field name="name">System Messages</field>
        <field name="path">elevenlabs-system-messages</field>
        <field name="res_model">connect.elevenlabs_system_message</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item (under Settings) -->
    <menuitem
        id="elevenlabs_system_message_menu"
        name="System Messages"
        action="elevenlabs_system_message_action"
        parent="connect.connect_settings_menu"
        sequence="25"/>
</odoo>
