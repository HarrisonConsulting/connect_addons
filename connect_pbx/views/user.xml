<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="user_list_audio" model="ir.ui.view">
        <field name="name">connect.user.list.audio</field>
        <field name="model">connect.user</field>
        <field name="inherit_id" ref="connect.view_connect_user_tree"/>
        <field name="arch" type="xml">
            <field name="voicemail_enabled" position="after">
                <field name="presence_status" string="Presence" widget="badge"
                       decoration-success="presence_status == 'available'"
                       decoration-danger="presence_status == 'on_call'"
                       decoration-warning="presence_status == 'on_hold'"
                       decoration-muted="presence_status == 'offline'"/>
            </field>
        </field>
    </record>

    <record id="user_form_audio" model="ir.ui.view">
        <field name="name">connect.user.form.audio</field>
        <field name="model">connect.user</field>
        <field name="inherit_id" ref="connect.view_connect_user_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='greeting_message']" position="before">
                <field name="greeting_audio_id"
                       domain="[('state', 'in', ('reviewed', 'live'))]"/>
                <field name="greeting_preview" widget="html"
                       nolabel="1" colspan="2"
                       invisible="not greeting_preview"/>
            </xpath>
            <xpath expr="//field[@name='voicemail_enabled']" position="after">
                <field name="voicemail_email_enabled"
                       invisible="not voicemail_enabled"/>
                <field name="voicemail_audio_id"
                       domain="[('state', 'in', ('reviewed', 'live'))]"
                       invisible="not voicemail_enabled"
                       required="voicemail_enabled"/>
                <field name="voicemail_preview" widget="html"
                       nolabel="1" colspan="2"
                       invisible="not voicemail_enabled or not voicemail_preview"/>
                <field name="voicemail_box_id"
                       invisible="not voicemail_enabled"
                       options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//page[@name='organization']" position="inside">
                <group string="Presence">
                    <field name="presence_status" readonly="1"/>
                    <field name="presence_updated" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
