<odoo>
    <record id="view_caller_reputation_list" model="ir.ui.view">
        <field name="name">connect.caller.reputation.list</field>
        <field name="model">connect.caller.reputation</field>
        <field name="arch" type="xml">
            <list>
                <field name="e164"/>
                <field name="line_type"/>
                <field name="carrier_name"/>
                <field name="last_attestation"/>
                <field name="active_mark_count"/>
                <field name="spam_score"/>
                <field name="last_seen"/>
            </list>
        </field>
    </record>

    <record id="view_caller_reputation_form" model="ir.ui.view">
        <field name="name">connect.caller.reputation.form</field>
        <field name="model">connect.caller.reputation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="e164"/>
                            <field name="country_code"/>
                            <field name="region"/>
                            <field name="npanxx"/>
                            <field name="line_type"/>
                            <field name="carrier_name"/>
                            <field name="cnam_last"/>
                            <field name="is_valid_number"/>
                        </group>
                        <group>
                            <field name="last_attestation"/>
                            <field name="attest_a_count"/>
                            <field name="attest_b_count"/>
                            <field name="attest_c_count"/>
                            <field name="attest_none_count"/>
                            <field name="attest_failed_count"/>
                            <field name="first_seen"/>
                            <field name="last_seen"/>
                            <field name="spam_score"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reports" name="marks">
                            <field name="mark_ids">
                                <list>
                                    <field name="reporter"/>
                                    <field name="category"/>
                                    <field name="report_count"/>
                                    <field name="last_reported"/>
                                    <field name="state"/>
                                    <field name="clearing_url" widget="url"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_caller_reputation" model="ir.actions.act_window">
        <field name="name">Number Reputation</field>
        <field name="res_model">connect.caller.reputation</field>
        <field name="path">caller-reputation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
