<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connect_message_tree" model="ir.ui.view">
        <field name="name">connect.message.tree</field>
        <field name="model">connect.message</field>
        <field name="arch" type="xml">
            <list default_order="create_date desc"
                  decoration-danger="status in ('failed', 'undeliverable', 'error')">
                <field name="status" column_invisible="1"/>
                <field name="direction_display" string=" " width="30px"/>
                <field name="status_display" string=" " width="30px"/>
                <field name="partner"/>
                <field name="from_number"/>
                <field name="to_number"/>
                <field name="body"/>
                <field name="message_type" optional="hide"/>
                <field name="create_date" string="Date"/>
            </list>
        </field>
    </record>

    <record id="view_connect_message_form" model="ir.ui.view">
        <field name="name">connect.message.form</field>
        <field name="model">connect.message</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_retry" type="object" string="Retry"
                            class="btn-primary" invisible="status != 'failed'"/>
                    <field name="direction" widget="badge"/>
                    <field name="status" widget="badge" invisible="not status"/>
                </header>
                <sheet>
                    <field name="media_url" invisible="1"/>
                    <group>
                        <group>
                            <field name="from_number" widget="phone"/>
                            <field name="partner"/>
                            <field name="partner_img" widget="image" class="oe_avatar"
                                   invisible="not partner"/>
                            <field name="sender_user" invisible="not sender_user"/>
                            <field name="sender_user_img" widget="image" class="oe_avatar"
                                   invisible="not sender_user"/>
                        </group>
                        <group>
                            <field name="to_number" widget="phone"/>
                            <field name="message_type"/>
                            <field name="ref" invisible="not ref"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="body" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Media" invisible="not media_url">
                        <field name="media_widget" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <!-- First parent_message in the arch. The carrier inherit
                             inserts its identifiers after this field, so they
                             stay on this debug page. -->
                        <page name="reference" string="Reference" groups="base.group_no_one">
                            <group>
                                <field name="parent_message" invisible="1"/>
                                <field name="message_sid"/>
                                <field name="media_url"/>
                                <field name="media_content_type" invisible="not media_content_type"/>
                            </group>
                        </page>
                        <page name="details" string="Details"
                              invisible="not parent_message and not from_city and not from_state and not from_zip and not from_country">
                            <group>
                                <field name="parent_message" invisible="not parent_message"/>
                            </group>
                            <group string="Where it was sent from"
                                   invisible="not from_city and not from_state and not from_zip and not from_country">
                                <field name="from_city"/>
                                <field name="from_state"/>
                                <field name="from_zip"/>
                                <field name="from_country"/>
                            </group>
                        </page>
                        <page name="error" string="Error" invisible="not has_error">
                            <group>
                                <field name="error_message" string="What happened"/>
                                <field name="error_code" string="Code"/>
                                <field name="has_error" invisible="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_connect_message_search" model="ir.ui.view">
        <field name="name">connect.message.search</field>
        <field name="model">connect.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner"/>
                <field name="from_number"/>
                <field name="to_number"/>
                <field name="body"/>
                <filter name="incoming" string="Incoming" domain="[('direction', '=', 'incoming')]"/>
                <filter name="outgoing" string="Outgoing" domain="[('direction', '=', 'outgoing')]"/>
                <filter name="failed" string="Failed"
                        domain="[('status', 'in', ('failed', 'undeliverable', 'error'))]"/>
                <group>
                    <filter name="by_partner" string="Contact" context="{'group_by': 'partner'}"/>
                    <filter name="by_direction" string="Direction" context="{'group_by': 'direction'}"/>
                    <filter name="by_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- The raw message log is for administrators and debugging. People read
         and send messages in the conversations interface (connect_pbx). -->
    <record id="action_connect_message" model="ir.actions.act_window">
        <field name="name">Message Log</field>
        <field name="res_model">connect.message</field>
        <field name="view_mode">list,form</field>
        <field name="path">connect-message</field>
    </record>

    <menuitem id="menu_connect_messages"
              name="Message Log"
              parent="connect_debug_menu"
              action="action_connect_message"
              sequence="40"/>

</odoo>
