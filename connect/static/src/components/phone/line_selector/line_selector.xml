<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="connect.line_selector" owl="1">
        <div class="o_phone_line_selector" role="group" aria-label="From">
            <div class="o_phone_line_row">
                <span class="o_phone_line_from">From</span>
                <select t-if="usesDropdown" class="o_phone_line_dropdown" aria-label="From number"
                        t-att-disabled="props.readonly" t-on-change="(ev) => this.selectChoice(ev.target.value)">
                    <option t-foreach="choices" t-as="item" t-key="item.key"
                            t-att-value="item.key" t-att-selected="item.selected" t-att-title="item.title">
                        <t t-out="item.title"/>
                    </option>
                </select>
                <div t-else="" role="radiogroup" aria-label="From number" class="d-flex flex-wrap flex-grow-1">
                    <button t-foreach="choices" t-as="item" t-key="item.key" type="button" role="radio"
                            t-attf-class="o_phone_line_chip{{item.selected ? ' active' : ''}}{{problem(item.line) ? ' o_phone_line_down' : ''}}"
                            t-att-tabindex="item.selected ? 0 : -1" t-on-keydown="(ev) => this.onChoiceKeydown(ev, item.key)"
                            t-att-aria-checked="item.selected ? 'true' : 'false'" t-att-aria-label="item.title"
                            t-att-title="item.title" t-att-disabled="props.readonly"
                            t-on-click="() => this.selectChoice(item.key)">
                        <t t-out="item.label"/>
                    </button>
                </div>
            </div>
            <div class="o_phone_line_caption">
                <div t-if="props.callerId" class="o_phone_line_caller_id">
                    <span>Caller ID</span>
                    <span class="o_phone_line_caller_id_value" t-out="props.callerId"/>
                </div>
                <div class="o_phone_line_how">
                    <span t-if="problem(props.line)" class="o_phone_line_problem" t-att-title="problem(props.line)" t-out="problem(props.line)"/>
                    <span t-else="" t-out="howItConnects"/>
                    <a t-if="!props.readonly" href="#" class="o_phone_line_change" t-on-click.prevent="() => props.onChangeHow()">Change</a>
                </div>
            </div>
        </div>
    </t>

</templates>
