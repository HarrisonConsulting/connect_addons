<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="twiml_search_audio" model="ir.ui.view">
        <field name="name">connect.twilio.twiml.search.audio</field>
        <field name="model">connect.twilio.twiml</field>
        <field name="inherit_id" ref="connect_twilio.view_connect_twiml_search"/>
        <field name="arch" type="xml">
            <filter name="by_type" position="before">
                <filter name="references_archived_audio"
                        string="References Archived Audio"
                        domain="[('referenced_audio_ids.state', '=', 'archived')]"/>
            </filter>
        </field>
    </record>

</odoo>
