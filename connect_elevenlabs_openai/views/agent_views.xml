<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend agent form to add custom LLM fields -->
    <record id="connect_elevenlabs_agent_form_openai" model="ir.ui.view">
        <field name="name">connect_elevenlabs_agent_form.openai</field>
        <field name="model">connect.elevenlabs_agent</field>
        <field name="inherit_id" ref="connect_elevenlabs.connect_elevenlabs_agent_form"/>
        <field name="arch" type="xml">
            <!-- Add custom_llm_model_id field after llm field -->
            <field name="llm" position="after">
                <field name="custom_llm_model_id"
                       invisible="llm != 'custom-llm'"
                       required="llm == 'custom-llm'"
                       options="{'no_create': True}"/>
            </field>

            <!-- Add Custom LLM Settings group before the closing page tag -->
            <field name="active" position="after">
                <group string="Custom LLM Settings" invisible="llm != 'custom-llm'">
                    <field name="custom_llm_extra_body"
                           placeholder='{"user_id": "123", "custom_param": "value"}'/>
                    <div class="text-muted" colspan="2">
                        <small>
                            Configure your OpenAI-compatible endpoint in
                            <a href="/web#action=base_setup.action_general_configuration" target="_blank">
                                Settings - Integrations - OpenAI Integration
                            </a>
                        </small>
                    </div>
                </group>
            </field>
        </field>
    </record>

</odoo>
