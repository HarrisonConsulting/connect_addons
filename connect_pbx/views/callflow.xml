<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="callflow_form_audio" model="ir.ui.view">
        <field name="name">connect.twilio.callflow.form.audio</field>
        <field name="model">connect.twilio.callflow</field>
        <field name="inherit_id" ref="connect_twilio.view_twilio_callflow_form"/>
        <field name="arch" type="xml">
            <field name="language" position="after">
                <field name="prompt_audio_id"
                    domain="[('state', 'in', ('reviewed', 'live'))]"/>
                <field name="prompt_preview" widget="html"
                    nolabel="1" colspan="2"
                    invisible="not prompt_preview"/>
            </field>
            <field name="gather_digits" position="after">
                <field name="invalid_input_audio_id"
                    domain="[('state', 'in', ('reviewed', 'live'))]"
                    invisible="gather_input == False"/>
                <field name="invalid_input_preview" widget="html"
                    nolabel="1" colspan="2"
                    invisible="gather_input == False or not invalid_input_preview"/>
            </field>
            <field name="voicemail_enabled" position="after">
                <field name="voicemail_audio_id"
                    domain="[('state', 'in', ('reviewed', 'live'))]"
                    invisible="not voicemail_enabled"
                    required="voicemail_enabled"/>
                <field name="voicemail_preview" widget="html"
                    nolabel="1" colspan="2"
                    invisible="not voicemail_enabled or not voicemail_preview"/>
                <field name="voicemail_box_id"
                    invisible="not voicemail_enabled"
                    options="{'no_create': True}"/>
            </field>
            <xpath expr="//group[@name='voicemail']" position="after">
                <group string="Business Hours">
                    <field name="schedule_id"/>
                    <field name="business_hours_enabled"/>
                    <field name="after_hours_voicemail"/>
                    <field name="after_hours_audio_id"
                        domain="[('state', 'in', ('reviewed', 'live'))]"
                        invisible="not schedule_id and not business_hours_enabled"/>
                    <field name="after_hours_preview" widget="html"
                        nolabel="1" colspan="2"
                        invisible="(not schedule_id and not business_hours_enabled) or not after_hours_preview"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
