<odoo>

    <!-- Conversation -->
    <record id="connect_conversation_admin_rule" model="ir.rule">
        <field name="name">connect_conversation_admin</field>
        <field name="model_id" ref="connect_hc_core.model_connect_conversation"/>
        <field name="groups" eval="[(6, 0, [ref('connect.group_connect_admin')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <!-- Voicemail Box -->
    <record id="connect_voicemail_box_admin_rule" model="ir.rule">
        <field name="name">connect_voicemail_box_admin</field>
        <field name="model_id" ref="connect_hc_core.model_connect_voicemail_box"/>
        <field name="groups" eval="[(6, 0, [ref('connect.group_connect_admin')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>


</odoo>
