<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="callflow_action" model="ir.actions.act_window">
        <field name="name">Call Flows</field>
        <field name="path">connect-callflows</field>
        <field name="res_model">connect.callflow</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="connect.callflows_menu"
            sequence="175"
            parent="connect.connect_voice_menu"
            name="Call Flows"
            action="connect.callflow_action"/>

    <record id="callflow_list" model="ir.ui.view">
        <field name="name">connect.callflow_list</field>
        <field name="model">connect.callflow</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="exten_number" string="Exten"/>
                <field name="record_calls"/>
            </list>
        </field>
    </record>

    <record id="callflow_form" model="ir.ui.view" >
        <field name="name">connect_callflow_form</field>
        <field name="model">connect.callflow</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="create_extension" type="object" string="Extension" class="btn btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <label class="oe_edit_only" for="name"/>
                            <field name="name" placeholder="Call Flow name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="language" placeholder='en-US'/>
                            <field name="prompt_audio_id"
                                domain="[('state', 'in', ('reviewed', 'live'))]"/>
                            <field name="prompt_preview" widget="html"
                                nolabel="1" colspan="2"
                                invisible="not prompt_preview"/>
                            <field name="gather_input"/>
                            <field name="gather_input_type" invisible="gather_input == False"/>
                            <field name="gather_timeout" invisible="gather_input == False"/>
                            <field name="gather_digits" invisible="gather_input == False"/>
                            <field name="invalid_input_audio_id"
                                domain="[('state', 'in', ('reviewed', 'live'))]"
                                invisible="gather_input == False"/>
                            <field name="invalid_input_preview" widget="html"
                                nolabel="1" colspan="2"
                                invisible="gather_input == False or not invalid_input_preview"/>
                            <field name="choices" invisible="gather_input == False">
                                <list editable="bottom">
                                    <field name="choice_digits" string="Digits"/>
                                    <field name="exten"/>
                                    <field name="speech"/>
                                </list>
                            </field>
                        </group>
                        <group>
                            <field name="ring_users" widget="many2many_tags"/>
                            <field name="record_calls"/>
                            <field name="voicemail_enabled"/>
                            <field name="voicemail_audio_id"
                                domain="[('state', 'in', ('reviewed', 'live'))]"
                                invisible="not voicemail_enabled"
                                required="voicemail_enabled"/>
                            <field name="voicemail_preview" widget="html"
                                nolabel="1" colspan="2"
                                invisible="not voicemail_enabled or not voicemail_preview"/>
                            <field name="exten_number"/>
                        </group>
                    </group>
                    <separator string="Business Hours"/>
                    <group>
                        <group>
                            <field name="schedule_id"
                                help="If set, overrides the simple business hours fields below."/>
                            <field name="business_hours_enabled"
                                invisible="schedule_id"/>
                            <field name="business_hours_start" widget="float_time"
                                invisible="schedule_id or not business_hours_enabled"/>
                            <field name="business_hours_end" widget="float_time"
                                invisible="schedule_id or not business_hours_enabled"/>
                            <field name="business_hours_timezone"
                                invisible="schedule_id or not business_hours_enabled"/>
                        </group>
                        <group>
                            <field name="after_hours_audio_id"
                                domain="[('state', 'in', ('reviewed', 'live'))]"
                                invisible="not schedule_id and not business_hours_enabled"/>
                            <field name="after_hours_preview" widget="html"
                                nolabel="1" colspan="2"
                                invisible="(not schedule_id and not business_hours_enabled) or not after_hours_preview"/>
                            <field name="after_hours_voicemail"
                                invisible="not schedule_id and not business_hours_enabled"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="connect_callflow_search" model="ir.ui.view" >
        <field name="name">connect_callflow_search</field>
        <field name="model">connect.callflow</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

</odoo>
