<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="voicemail_stage_pending" model="connect.voicemail_stage">
        <field name="name">Pending</field>
        <field name="sequence">10</field>
        <field name="fold" eval="False"/>
    </record>

    <record id="voicemail_stage_working" model="connect.voicemail_stage">
        <field name="name">Actively Working On</field>
        <field name="sequence">20</field>
        <field name="fold" eval="False"/>
    </record>

    <record id="voicemail_stage_review" model="connect.voicemail_stage">
        <field name="name">For Review</field>
        <field name="sequence">30</field>
        <field name="fold" eval="False"/>
    </record>

    <record id="voicemail_stage_completed" model="connect.voicemail_stage">
        <field name="name">Completed</field>
        <field name="sequence">40</field>
        <field name="fold" eval="True"/>
    </record>

</odoo>
