<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!-- Dedicated queue_job channel so transcription retries don't starve
         other jobs and can be throttled independently. Capacity is the number
         of concurrent chunk transcriptions allowed. Start conservative (2)
         and bump via ir.config_parameter once we understand steady-state load. -->
    <record id="channel_connect_transcription" model="queue.job.channel">
        <field name="name">connect_transcription</field>
        <field name="parent_id" ref="queue_job.channel_root"/>
        <!-- Start with 2 concurrent transcription uploads to respect upstream
             rate limits; bump via Queue Jobs UI or ODOO_QUEUE_JOB_CHANNELS
             once steady-state load is known. -->
        <field name="capacity">2</field>
    </record>
</odoo>
