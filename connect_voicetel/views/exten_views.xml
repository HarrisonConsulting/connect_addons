<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_voicetel_exten_list" model="ir.ui.view">
        <field name="name">connect.voicetel.exten.list</field>
        <field name="model">connect.voicetel.exten</field>
        <field name="arch" type="xml">
            <list>
                <field name="number"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_voicetel_exten_form" model="ir.ui.view">
        <field name="name">connect.voicetel.exten.form</field>
        <field name="model">connect.voicetel.exten</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="number"/>
                        <field name="dst"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_voicetel_exten" model="ir.actions.act_window">
        <field name="name">Extensions</field>
        <field name="res_model">connect.voicetel.exten</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_voicetel_extens"
              name="Extensions"
              parent="menu_connect_voicetel"
              action="action_voicetel_exten"
              sequence="20"/>
</odoo>
