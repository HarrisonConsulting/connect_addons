<odoo>

  <record id="connect_settings_migrate_wizard_form" model="ir.ui.view">
    <field name="name">connect.settings.migrate.wizard.form</field>
    <field name="model">connect.settings.migrate.wizard</field>
    <field name="arch" type="xml">
      <form string="Migrate Account">
        <field name="state" invisible="1"/>
        <div colspan="2" invisible="state != 'draft'">
          <p>Migrate phone numbers, TwiML apps and SIP domains to another
            Twilio-API-compatible account and switch Connect to it. Each is
            matched by its natural key (phone number, app name, domain name):
            already present ones adopt the target SID, missing ones are
            created. Run a dry run first — it changes nothing.</p>
        </div>
        <group invisible="state == 'done'">
          <field name="target_account_sid" readonly="state != 'draft'"/>
          <field name="target_auth_token" password="1" readonly="state != 'draft'"/>
          <field name="target_rest_api_host" placeholder="Leave empty for Twilio" readonly="state != 'draft'"/>
        </group>
        <field name="result" nolabel="1" invisible="state == 'draft'"/>
        <footer>
          <button name="action_preview" type="object" string="DRY RUN"
                  class="btn-primary" invisible="state == 'done'"/>
          <button name="action_migrate" type="object" string="MIGRATE"
                  class="btn-danger" invisible="state != 'preview'"
                  confirm="Migrate all numbers, TwiML apps and SIP domains to the target account and switch Connect credentials to it. This cannot be undone from the wizard. Continue?"/>
          <button special="cancel" string="Close" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="connect_settings_migrate_wizard_action" model="ir.actions.act_window">
    <field name="name">Migrate Account</field>
    <field name="res_model">connect.settings.migrate.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

</odoo>
