<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_voicetel_application_list" model="ir.ui.view">
        <field name="name">connect.voicetel.application.list</field>
        <field name="model">connect.voicetel.application</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code_type"/>
                <field name="sid"/>
            </list>
        </field>
    </record>

    <record id="view_voicetel_application_form" model="ir.ui.view">
        <field name="name">connect.voicetel.application.form</field>
        <field name="model">connect.voicetel.application</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="code_type"/>
                            <field name="model" invisible="code_type != 'model_method'"/>
                            <field name="method" invisible="code_type != 'model_method'"/>
                        </group>
                        <group>
                            <field name="sid"/>
                        </group>
                    </group>
                    <group string="Call Control XML" invisible="code_type != 'twiml'">
                        <field name="twiml" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_voicetel_application" model="ir.actions.act_window">
        <field name="name">Applications</field>
        <field name="res_model">connect.voicetel.application</field>
        <field name="view_mode">list,form</field>
        <field name="path">voicetel-application</field>
    </record>

    <menuitem id="menu_voicetel_applications"
              name="Applications"
              parent="menu_connect_voicetel"
              action="action_voicetel_application"
              sequence="50"/>
</odoo>
