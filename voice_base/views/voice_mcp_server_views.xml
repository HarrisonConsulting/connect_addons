<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- MCP Server List View -->
    <record id="view_voice_mcp_server_list" model="ir.ui.view">
        <field name="name">voice.mcp.server.list</field>
        <field name="model">voice.mcp.server</field>
        <field name="arch" type="xml">
            <list string="MCP Servers">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="url"/>
                <field name="transport"/>
                <field name="approval_policy"/>
                <field name="sync_status" widget="badge"
                       decoration-info="sync_status == 'draft'"
                       decoration-warning="sync_status == 'syncing'"
                       decoration-success="sync_status == 'synced'"
                       decoration-danger="sync_status == 'error'"/>
                <field name="health_status" widget="badge"
                       decoration-success="health_status == 'healthy'"
                       decoration-warning="health_status == 'degraded'"
                       decoration-danger="health_status == 'down'"/>
                <field name="tool_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- MCP Server Form View -->
    <record id="view_voice_mcp_server_form" model="ir.ui.view">
        <field name="name">voice.mcp.server.form</field>
        <field name="model">voice.mcp.server</field>
        <field name="arch" type="xml">
            <form string="MCP Server">
                <header>
                    <button name="action_health_check" type="object" string="Health Check" class="btn-primary"/>
                    <button name="action_sync_tools" type="object" string="Sync Tools" class="btn-secondary"/>
                    <field name="sync_status" widget="statusbar" statusbar_visible="draft,synced"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="url" placeholder="https://mcp-server.example.com/sse"/>
                            <field name="transport"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="external_id" readonly="1"/>
                            <field name="health_status"/>
                            <field name="last_health_check"/>
                            <field name="last_sync"/>
                            <field name="tool_count"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Describe what this MCP server provides"/>
                    </group>
                    <div invisible="not sync_error" class="alert alert-danger" role="alert">
                        <field name="sync_error" nolabel="1" readonly="1"/>
                    </div>

                    <notebook>
                        <page string="Authentication" name="auth">
                            <group string="Authentication">
                                <group>
                                    <field name="auth_type"/>
                                    <field name="auth_token" password="True" invisible="auth_type == 'none'"/>
                                    <field name="auth_header_name" invisible="auth_type not in ('api_key', 'custom')"/>
                                </group>
                                <group>
                                    <field name="custom_headers" placeholder='{"X-Custom-Header": "value"}'/>
                                </group>
                            </group>
                        </page>

                        <page string="Tool Approval" name="approval">
                            <group string="Approval Policy">
                                <group>
                                    <field name="approval_policy"/>
                                </group>
                            </group>
                            <group invisible="approval_policy != 'per_tool'" string="Allowed Tools">
                                <field name="allowed_tools" placeholder="tool1, tool2, tool3"
                                       help="Comma-separated list of tools to auto-approve"/>
                            </group>
                            <group invisible="approval_policy != 'per_tool'" string="Tool Overrides">
                                <field name="tool_override_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="tool_name"/>
                                        <field name="name"/>
                                        <field name="approval_status"/>
                                        <field name="pre_tool_message"/>
                                        <field name="execution_sound"/>
                                    </list>
                                </field>
                            </group>
                        </page>

                        <page string="Execution" name="execution">
                            <group string="Execution Mode">
                                <group>
                                    <field name="execution_mode"/>
                                    <field name="force_pre_tool_message"/>
                                    <field name="disable_interruptions"/>
                                    <field name="disable_compression"/>
                                </group>
                            </group>
                            <group string="Execution Sound">
                                <group>
                                    <field name="execution_sound"/>
                                    <field name="execution_sound_behavior" invisible="execution_sound == 'none'"/>
                                </group>
                            </group>
                        </page>

                        <page string="Statistics" name="stats">
                            <group>
                                <group>
                                    <field name="usage_count"/>
                                    <field name="error_count"/>
                                </group>
                                <group>
                                    <field name="health_message"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- MCP Tool Override Form View -->
    <record id="view_voice_mcp_tool_override_form" model="ir.ui.view">
        <field name="name">voice.mcp.tool.override.form</field>
        <field name="model">voice.mcp.tool.override</field>
        <field name="arch" type="xml">
            <form string="Tool Override">
                <sheet>
                    <group>
                        <group>
                            <field name="tool_name"/>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="mcp_server_id"/>
                        </group>
                        <group>
                            <field name="approval_status"/>
                            <field name="force_pre_tool_message"/>
                        </group>
                    </group>
                    <group string="Pre-Tool Message">
                        <field name="pre_tool_message" placeholder="Let me check that for you..."/>
                    </group>
                    <group string="Execution Sound">
                        <group>
                            <field name="execution_sound"/>
                            <field name="execution_sound_behavior"/>
                        </group>
                    </group>
                    <group string="Overrides">
                        <field name="description_override" placeholder="Override the tool description..."/>
                        <field name="parameters_override" placeholder='{"type": "object", "properties": {...}}'/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- MCP Server Search View -->
    <record id="view_voice_mcp_server_search" model="ir.ui.view">
        <field name="name">voice.mcp.server.search</field>
        <field name="model">voice.mcp.server</field>
        <field name="arch" type="xml">
            <search string="MCP Servers">
                <field name="name"/>
                <field name="url"/>
                <filter string="Synced" name="filter_synced" domain="[('sync_status', '=', 'synced')]"/>
                <filter string="Needs Sync" name="filter_needs_sync" domain="[('sync_status', 'in', ('draft', 'error'))]"/>
                <separator/>
                <filter string="Healthy" name="filter_healthy" domain="[('health_status', '=', 'healthy')]"/>
                <filter string="Degraded" name="filter_degraded" domain="[('health_status', '=', 'degraded')]"/>
                <filter string="Down" name="filter_down" domain="[('health_status', '=', 'down')]"/>
                <separator/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Sync Status" name="group_sync" context="{'group_by': 'sync_status'}"/>
                    <filter string="Health Status" name="group_health" context="{'group_by': 'health_status'}"/>
                    <filter string="Transport" name="group_transport" context="{'group_by': 'transport'}"/>
                    <filter string="Approval Policy" name="group_approval" context="{'group_by': 'approval_policy'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- MCP Server Action -->
    <record id="action_voice_mcp_server" model="ir.actions.act_window">
        <field name="name">MCP Servers</field>
        <field name="path">voice-mcp-servers</field>
        <field name="res_model">voice.mcp.server</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first MCP server
            </p>
            <p>
                MCP (Model Context Protocol) servers provide additional capabilities
                to voice agents through a standardized protocol.
            </p>
        </field>
    </record>

</odoo>
