<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- priority 1020: after Connect's own settings app (priority 1000). -->
    <record id="res_config_settings_view_form_connect_voicetel" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.connect.voicetel</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="1020"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='connect']" position="inside">
                <block title="VoiceTel" name="connect_voicetel_account" invisible="not module_connect_voicetel">
                    <setting string="VoiceTel Account SID" help="Account SID from your VoiceTel account; identifies your account on the VoiceML REST API.">
                        <field name="connect_voicetel_account_sid"/>
                    </setting>
                    <setting string="API Key" help="API key from your VoiceTel account; used as the auth token for the VoiceML REST API.">
                        <field name="connect_voicetel_api_key" password="True"/>
                    </setting>
                    <setting string="API Secret" help="API secret from your VoiceTel account; reserved for features that require key/secret authentication, such as the browser phone.">
                        <field name="connect_voicetel_api_secret" password="True"/>
                    </setting>
                    <setting string="REST API Host" help="Hostname of the VoiceML REST API. Leave the default unless VoiceTel support tells you otherwise.">
                        <field name="connect_voicetel_rest_host"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
