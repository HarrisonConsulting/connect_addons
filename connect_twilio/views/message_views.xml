<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connect_message_form_twilio" model="ir.ui.view">
        <field name="name">connect.message.form.twilio</field>
        <field name="model">connect.message</field>
        <field name="inherit_id" ref="connect.view_connect_message_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Twilio" groups="base.group_no_one"
                       invisible="not account_sid and not messaging_service_sid">
                    <field name="account_sid"/>
                    <field name="messaging_service_sid"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
