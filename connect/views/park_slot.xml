<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="park_slot_action" model="ir.actions.act_window">
            <field name="name">Park Slots</field>
            <field name="path">connect-park-slots</field>
            <field name="res_model">connect.park_slot</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="connect.park_slot_menu"
                  sequence="55"
                  parent="connect.connect_voice_menu"
                  name="Park Slots"
                  action="connect.park_slot_action"/>

        <record id="connect_park_slot_list" model="ir.ui.view">
            <field name="name">connect.park_slot.list</field>
            <field name="model">connect.park_slot</field>
            <field name="arch" type="xml">
                <list create="false" edit="false"
                      decoration-success="is_occupied"
                      decoration-danger="is_occupied and park_duration &gt; 240">
                    <field name="is_occupied" column_invisible="1"/>
                    <field name="park_duration" column_invisible="1"/>
                    <field name="name" string="Slot"/>
                    <field name="caller_display"/>
                    <field name="parked_by"/>
                    <field name="parked_at"/>
                    <field name="park_duration" string="Duration (s)" widget="integer"
                           invisible="not is_occupied"/>
                    <button name="action_unpark" string="Pick Up" type="object"
                            class="btn-primary" icon="fa-phone"
                            invisible="not is_occupied"/>
                </list>
            </field>
        </record>

        <record id="connect_park_slot_form" model="ir.ui.view">
            <field name="name">connect.park_slot.form</field>
            <field name="model">connect.park_slot</field>
            <field name="arch" type="xml">
                <form create="false">
                    <header>
                        <button name="action_unpark" string="Pick Up" type="object"
                                class="btn-primary" icon="fa-phone"
                                invisible="not is_occupied"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" string="Slot"/>
                                <field name="is_occupied"/>
                                <field name="caller_display"/>
                                <field name="park_duration" string="Duration (s)"
                                       invisible="not is_occupied"/>
                            </group>
                            <group>
                                <field name="call"/>
                                <field name="parked_by"/>
                                <field name="parked_at"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="connect_park_slot_search" model="ir.ui.view">
            <field name="name">connect.park_slot.search</field>
            <field name="model">connect.park_slot</field>
            <field name="arch" type="xml">
                <search>
                    <filter name="occupied" string="Occupied" domain="[('call', '!=', False)]"/>
                    <filter name="empty" string="Empty" domain="[('call', '=', False)]"/>
                    <field name="name" string="Slot"/>
                    <field name="parked_by"/>
                </search>
            </field>
        </record>
    </data>
</odoo>
