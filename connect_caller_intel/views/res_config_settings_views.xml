<odoo>
    <record id="res_config_settings_view_form_caller_intel" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.caller.intel</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="connect.res_config_settings_view_form_connect"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='connect']" position="inside">
                <block title="Caller intelligence" name="connect_caller_intel_settings">
                    <div class="col-12 o_setting_box" colspan="2"
                         invisible="not caller_intel_paid_source_ids">
                        <div class="alert alert-warning w-100" role="alert">
                            <i class="fa fa-exclamation-triangle" title="Paid sources are enabled"/>
                            These enabled sources cost extra per lookup:
                            <field name="caller_intel_paid_source_ids" widget="many2many_tags" readonly="1"/>
                        </div>
                    </div>
                    <setting string="Suspicious from" help="Reputation score from which a caller is shown as suspicious.">
                        <field name="caller_intel_threshold_suspicious"/>
                    </setting>
                    <setting string="Likely spam from" help="Reputation score from which a caller is shown as likely spam.">
                        <field name="caller_intel_threshold_spam"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
