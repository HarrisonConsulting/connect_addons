<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connect_textable_number_list" model="ir.ui.view">
        <field name="name">connect.textable.number.list</field>
        <field name="model">connect.textable.number</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="phone_number" widget="phone"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="textable_user_id"/>
                <field name="campaign_state" widget="badge"
                       decoration-success="campaign_state == 'approved'"
                       decoration-warning="campaign_state == 'not_approved'"/>
                <field name="textable_credentials_set"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_connect_textable_number_form" model="ir.ui.view">
        <field name="name">connect.textable.number.form</field>
        <field name="model">connect.textable.number</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_textable_test_connection" type="object"
                            string="Test connection" groups="base.group_system"
                            invisible="not id"/>
                    <button name="action_textable_open_test_message" type="object"
                            string="Send test message" groups="base.group_system"
                            invisible="not id or campaign_state != 'approved'"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group string="Number" name="number">
                            <field name="name"/>
                            <field name="phone_number" placeholder="+13125550123"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="textable_user_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Token" name="token">
                            <field name="display_account_uid" password="1"/>
                            <field name="display_api_key" password="1"/>
                            <field name="textable_credentials_set"/>
                        </group>
                        <group string="10DLC Campaign" name="campaign">
                            <field name="campaign_state" widget="radio"/>
                            <field name="campaign_use_case"/>
                            <field name="campaign_reference"
                                   required="campaign_state == 'approved'"/>
                        </group>
                        <group string="Caps" name="caps">
                            <field name="hourly_cap"/>
                            <field name="daily_cap"/>
                            <field name="recipient_daily_cap"/>
                            <field name="optout_hourly_cap"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Assigned Users" name="users">
                            <field name="user_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_connect_textable_number_search" model="ir.ui.view">
        <field name="name">connect.textable.number.search</field>
        <field name="model">connect.textable.number</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="phone_number"/>
                <field name="textable_user_id"/>
                <filter string="Campaign not approved" name="not_approved"
                        domain="[('campaign_state', '=', 'not_approved')]"/>
                <separator/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Campaign" name="group_campaign" context="{'group_by': 'campaign_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_connect_textable_number" model="ir.actions.act_window">
        <field name="name">Textable Numbers</field>
        <field name="res_model">connect.textable.number</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a Textable sender number</p>
            <p>Each number carries the token of the Textable user that holds it.
                Nothing is sent from a number until its 10DLC campaign is approved.</p>
        </field>
    </record>
</odoo>
