<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!-- Audio larger than this (in MB) is chunked; smaller goes single-shot. -->
    <record id="param_threshold_mb" model="ir.config_parameter">
        <field name="key">connect_chunked_transcription.threshold_mb</field>
        <field name="value">10</field>
    </record>

    <!-- Target duration per chunk. Silences within +/-30s shift actual cuts. -->
    <record id="param_target_chunk_seconds" model="ir.config_parameter">
        <field name="key">connect_chunked_transcription.target_chunk_seconds</field>
        <field name="value">180</field>
    </record>

    <!-- Minimum silence duration (ms) to qualify as a cut point. -->
    <record id="param_min_silence_ms" model="ir.config_parameter">
        <field name="key">connect_chunked_transcription.min_silence_ms</field>
        <field name="value">500</field>
    </record>

    <!-- RMS dBFS threshold below which a window counts as silence. -->
    <record id="param_silence_rms_db" model="ir.config_parameter">
        <field name="key">connect_chunked_transcription.silence_rms_db</field>
        <field name="value">-40.0</field>
    </record>

    <!-- Transcription model route. Defaults to the self-hosted HC route. -->
    <record id="param_model" model="ir.config_parameter">
        <field name="key">connect_chunked_transcription.model</field>
        <field name="value">orion/whisper-large-v3</field>
    </record>
</odoo>
