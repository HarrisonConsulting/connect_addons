<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Voice AI Settings View -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.voice_base</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="200"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Voice AI" string="Voice AI" name="voice_base"
                     groups="voice_base.group_voice_manager">

                    <block title="General" name="voice_general_block">
                        <setting string="Enable Voice AI" help="Enable Voice AI features">
                            <field name="voice_ai_enabled"/>
                        </setting>
                    </block>

                    <!-- ElevenLabs Block - Extended by voice_elevenlabs module -->
                    <block title="ElevenLabs" name="voice_elevenlabs_block" invisible="True">
                        <!-- Content added by voice_elevenlabs module -->
                    </block>

                    <!-- Agent Configuration Block - Extended by voice_elevenlabs_connect module -->
                    <block title="Agent Configuration" name="voice_agent_block" invisible="True">
                        <!-- Content added by voice_elevenlabs_connect module -->
                    </block>

                    <!-- Webhooks Block - Extended by voice_elevenlabs_connect module -->
                    <block title="Webhooks" name="voice_webhooks_block" invisible="True">
                        <!-- Content added by voice_elevenlabs_connect module -->
                    </block>

                </app>
            </xpath>
        </field>
    </record>

    <!-- Settings Action -->
    <record id="voice_config_settings_action" model="ir.actions.act_window">
        <field name="name">Voice AI Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="path">voice-ai-settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'voice_base'}</field>
    </record>

</odoo>
