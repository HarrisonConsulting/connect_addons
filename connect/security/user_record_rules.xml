<odoo>

    <!-- User Callflow -->
    <record id="connect_user_callflow_user_rule" model="ir.rule">
        <field name="name">connect_user_callflow_user_rule</field>
        <field name="model_id" ref="connect.model_connect_user_callflow"/>
        <field name="groups" eval="[(6, 0, [ref('group_connect_user')])]"/>
        <field name="domain_force">[('user', '=', user.id)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>


    <!-- Callflow -->
    <record id="connect_callflow_user_rule" model="ir.rule">
        <field name="name">connect_callflow_user</field>
        <field name="model_id" ref="connect.model_connect_callflow"/>
        <field name="groups" eval="[(6, 0, [ref('group_connect_user')])]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="0"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Callflow Gather Choice -->
    <record id="connect_callflow_choice_user_rule" model="ir.rule">
        <field name="name">connect_callflow_choice_user</field>
        <field name="model_id" ref="connect.model_connect_callflow_choice"/>
        <field name="groups" eval="[(6, 0, [ref('group_connect_user')])]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="0"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Call -->
    <record id="connect_call_user_rule" model="ir.rule">
        <field name="name">connect_call_user</field>
        <field name="model_id" ref="connect.model_connect_call"/>
        <field name="groups" eval="[(6, 0, [ref('group_connect_user')])]"/>
        <field name="domain_force">['|', '|', '|', '|', ('caller_user', '=', user.id), ('called_users', '=', user.id), ('answered_user', '=', user.id), ('voicemail_box_id.member_ids', 'in', [user.id]), '&amp;', ('voicemail_box_id', '=', False), ('voicemail_url', '!=', False)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Voicemail Box: users see only boxes they belong to -->
    <record id="connect_voicemail_box_user_rule" model="ir.rule">
        <field name="name">connect_voicemail_box_user</field>
        <field name="model_id" ref="connect.model_connect_voicemail_box"/>
        <field name="groups" eval="[(6, 0, [ref('group_connect_user')])]"/>
        <field name="domain_force">[('member_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Channel -->
    <record id="connect_channel_user_rule" model="ir.rule">
        <field name="name">connect_channel_user</field>
        <field name="model_id" ref="connect.model_connect_channel"/>
        <field name="groups" eval="[(6, 0, [ref('group_connect_user')])]"/>
        <field name="domain_force">['|', ('caller_user', '=', user.id), ('called_user', '=', user.id)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Recording -->
    <record id="connect_recording_user_rule" model="ir.rule">
        <field name="name">connect_recording_user</field>
        <field name="model_id" ref="connect.model_connect_recording"/>
        <field name="groups" eval="[(6, 0, [ref('group_connect_user')])]"/>
        <field name="domain_force">['|', ('caller_user', '=', user.id), ('called_user', '=', user.id)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Favorites -->
    <record id="connect_favorite_user_rule" model="ir.rule">
        <field name="name">connect_favorite_user</field>
        <field name="model_id" ref="connect.model_connect_favorite"/>
        <field name="groups" eval="[(6, 0, [ref('group_connect_user')])]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <!-- Message -->
    <record id="connect_message_user_rule" model="ir.rule">
        <field name="name">connect_message_user</field>
        <field name="model_id" ref="connect.model_connect_message"/>
        <field name="groups" eval="[(6, 0, [ref('group_connect_user')])]"/>
        <field name="domain_force">[('sender_user', '=', user.id)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Partner: connect users can read all partners (cross-company) for conversations -->
    <record id="connect_partner_read_rule" model="ir.rule">
        <field name="name">connect_partner_read</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(6, 0, [ref('group_connect_user')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Conversation: all connect users can see all conversations -->
    <record id="connect_conversation_user_rule" model="ir.rule">
        <field name="name">connect_conversation_user</field>
        <field name="model_id" ref="connect.model_connect_conversation"/>
        <field name="groups" eval="[(6, 0, [ref('group_connect_user')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

</odoo>
