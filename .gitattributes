# Line-ending policy: this repo is developed on Linux/WSL — LF everywhere.
# A CR in a shell-script shebang produces `bad interpreter: /bin/bash^M`.

* text=auto eol=lf

# Explicit text types (belt-and-suspenders over text=auto)
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.md text eol=lf
*.rst text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.csv text eol=lf
*.po text eol=lf
*.pot text eol=lf
*.proto text eol=lf
*.ipynb text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows-specific scripts keep CRLF (rare in this codebase, but pinned anyway).
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never apply line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.zip binary
*.gz binary
*.tar binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.wasm binary
*.so binary
*.mo binary
*.db binary
*.pyc binary
