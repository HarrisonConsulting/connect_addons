<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="connect_stripe_call_form_inherit" model="ir.ui.view">
        <field name="name">connect_stripe_call_form_inherit</field>
        <field name="model">connect.call</field>
        <field name="inherit_id" ref="connect.connect_call_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="%(connect_stripe.connect_stripe_payment_action)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-credit-card"
                        invisible="stripe_payment_count == 0">
                    <field name="stripe_payment_count" widget="statinfo" string="Payments"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
