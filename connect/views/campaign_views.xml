<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connect_campaign_list" model="ir.ui.view">
        <field name="name">connect.campaign.list</field>
        <field name="model">connect.campaign</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="tool_id"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_connect_campaign_form" model="ir.ui.view">
        <field name="name">connect.campaign.form</field>
        <field name="model">connect.campaign</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="tool_id"/>
                        <field name="user_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_connect_campaign" model="ir.actions.act_window">
        <field name="name">Campaigns</field>
        <field name="res_model">connect.campaign</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_connect_campaign"
              name="Campaigns"
              parent="connect_voice_menu"
              action="action_connect_campaign"
              sequence="40"/>
</odoo>
