<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Standalone Textable settings form on the shared connect.settings
         singleton, opened from Connect > Configuration > Textable. -->
    <record id="connect_settings_form_textable" model="ir.ui.view">
        <field name="name">connect.settings.form.textable</field>
        <field name="model">connect.settings</field>
        <field name="inherit_id" eval="False"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <sheet>
                    <group>
                        <group string="Textable Tenant" name="textable_tenant">
                            <div colspan="2">
                                <small>Tokens are set per sender number, under Numbers. Nothing
                                    calls Textable on install or on a schedule.</small>
                            </div>
                            <field name="textable_base_url" placeholder="https://label.textable.app"/>
                            <field name="textable_organization_id"/>
                        </group>
                        <group string="Relay Webhook" name="textable_relay">
                            <div colspan="2">
                                <small>Rotating shows the relay URL once and keeps only its hash.
                                    The previous URL stops working at once.</small>
                            </div>
                            <field name="textable_relay_configured"/>
                            <field name="textable_relay_rotated_at"/>
                            <button colspan="2" name="rotate_textable_relay_secret" type="object"
                                    string="Rotate relay secret" class="btn btn-secondary"
                                    confirm="The current relay URL stops working at once. Rotate the relay secret?"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="textable_settings_action" model="ir.actions.server">
        <field name="name">Textable Settings</field>
        <field name="model_id" ref="connect.model_connect_settings"/>
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="state">code</field>
        <field name="code">action = model.open_settings_form("connect_textable.connect_settings_form_textable", "Textable Settings")</field>
    </record>
</odoo>
