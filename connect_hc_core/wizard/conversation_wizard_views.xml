<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_connect_conversation_wizard_form" model="ir.ui.view">
        <field name="name">connect.conversation_wizard.form</field>
        <field name="model">connect.conversation_wizard</field>
        <field name="arch" type="xml">
            <form string="New Conversation">
                <group>
                    <field name="partner_id" placeholder="Search contacts..."/>
                    <field name="phone" widget="phone"/>
                    <field name="channel_type" widget="radio"/>
                    <field name="phone_a" widget="phone"/>
                </group>
                <footer>
                    <button name="action_start_conversation" type="object"
                            string="Open Conversation" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_connect_conversation_wizard" model="ir.actions.act_window">
        <field name="name">New Conversation</field>
        <field name="res_model">connect.conversation_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
