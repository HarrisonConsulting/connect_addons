<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connect_endpoint_list" model="ir.ui.view">
        <field name="name">connect.endpoint.list</field>
        <field name="model">connect.endpoint</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="vendor"/>
                <field name="product_id"/>
            </list>
        </field>
    </record>

    <record id="view_connect_endpoint_form" model="ir.ui.view">
        <field name="name">connect.endpoint.form</field>
        <field name="model">connect.endpoint</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="vendor"/>
                        <field name="product_id"/>
                    </group>
                    <group string="Accounts">
                        <field name="account_ids" nolabel="1" colspan="2">
                            <list editable="bottom" default_order="slot">
                                <field name="slot"/>
                                <field name="name"/>
                                <field name="tool_id"/>
                                <field name="sip_user"/>
                                <field name="sip_server"/>
                                <field name="user_id"/>
                                <field name="transport"/>
                                <field name="registration" readonly="1"/>
                            </list>
                        </field>
                    </group>
                    <group string="Line keys">
                        <field name="line_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="sequence"/>
                                <field name="account_id" domain="[('endpoint_id', '=', parent.id)]"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_connect_endpoint" model="ir.actions.act_window">
        <field name="name">Desk phones</field>
        <field name="res_model">connect.endpoint</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
