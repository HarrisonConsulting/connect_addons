<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_connect_conversation" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="path">connect-conversations</field>
        <field name="res_model">connect.conversation</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="connect_conversation_menu"
              name="Conversations"
              action="action_connect_conversation"
              sequence="60"
              parent="connect.connect_messaging_menu"/>

    <!-- Search View -->
    <record id="view_connect_conversation_search" model="ir.ui.view">
        <field name="name">connect.conversation.search</field>
        <field name="model">connect.conversation</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" string="Contact"/>
                <field name="phone_b" string="Number" filter_domain="[('phone_b', 'ilike', self)]"/>
                <field name="last_message_body" string="Message" filter_domain="[('last_message_body', 'ilike', self)]"/>
                <separator/>
                <filter string="SMS" name="sms" domain="[('channel_type', '=', 'sms')]"/>
                <filter string="WhatsApp" name="whatsapp" domain="[('channel_type', '=', 'whatsapp')]"/>
                <separator/>
                <filter string="Has Error" name="has_error" domain="[('has_error', '=', True)]"/>
                <separator/>
                <filter string="Today" name="today" domain="[('last_message_date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Last 7 Days" name="last_7_days" domain="[('last_message_date', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter string="Contact" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Channel" name="group_channel" context="{'group_by': 'channel_type'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'last_message_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_connect_conversation_kanban" model="ir.ui.view">
        <field name="name">connect.conversation.kanban</field>
        <field name="model">connect.conversation</field>
        <field name="arch" type="xml">
            <kanban class="o_connect_conversation_kanban" create="0"
                    default_order="last_message_date desc" sample="1">
                <field name="partner_id"/>
                <field name="phone_b"/>
                <field name="channel_type"/>
                <field name="last_message_body"/>
                <field name="last_message_date"/>
                <field name="last_message_direction"/>
                <field name="message_count"/>
                <field name="has_error"/>
                <header>
                    <button name="%(connect.action_connect_conversation_wizard)d"
                            type="action" string="New" class="btn-primary"/>
                </header>
                <templates>
                    <t t-name="card" class="flex-row align-items-start gap-2 p-2">
                        <!-- Avatar initial -->
                        <span class="rounded-circle o_connect_conv_avatar d-flex align-items-center justify-content-center bg-secondary text-white fw-bold">
                            <t t-esc="(record.partner_id.value || record.phone_b.value || '?')[0].toUpperCase()"/>
                        </span>
                        <!-- Content -->
                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="text-truncate">
                                    <field name="partner_id" invisible="not partner_id"/>
                                    <span t-if="!record.partner_id.raw_value">
                                        <field name="phone_b"/>
                                    </span>
                                </strong>
                                <small class="text-muted ms-2 text-nowrap">
                                    <field name="last_message_date" widget="date"/>
                                </small>
                            </div>
                            <div class="d-flex align-items-center gap-1 text-muted small text-truncate">
                                <i t-if="record.channel_type.raw_value === 'whatsapp'"
                                   class="fa fa-whatsapp text-success" title="WhatsApp"/>
                                <i t-else="" class="fa fa-comment-o" title="SMS"/>
                                <span t-if="record.last_message_direction.raw_value === 'outgoing'"
                                      class="text-muted">You: </span>
                                <span class="text-truncate"><field name="last_message_body"/></span>
                            </div>
                            <div t-if="record.has_error.raw_value" class="mt-1">
                                <span class="badge text-bg-danger">Error</span>
                            </div>
                        </div>
                        <!-- Message count badge -->
                        <span t-if="record.message_count.raw_value > 0"
                              class="badge rounded-pill text-bg-primary align-self-center">
                            <field name="message_count"/>
                        </span>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List View -->
    <record id="view_connect_conversation_list" model="ir.ui.view">
        <field name="name">connect.conversation.list</field>
        <field name="model">connect.conversation</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="has_error" default_order="last_message_date desc">
                <field name="has_error" invisible="1"/>
                <field name="partner_id" widget="many2one_avatar" string="Contact"/>
                <field name="phone_b" string="Number" widget="phone"/>
                <field name="channel_type" string="Channel"/>
                <field name="last_message_body" string="Last Message"/>
                <field name="last_message_date" string="Date"/>
                <field name="message_count" string="Messages"/>
                <header>
                    <button name="%(connect.action_connect_conversation_wizard)d"
                            type="action" string="New" class="btn-primary"/>
                </header>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_connect_conversation_form" model="ir.ui.view">
        <field name="name">connect.conversation.form</field>
        <field name="model">connect.conversation</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div>
                            <h2 class="mb-0">
                                <field name="name" readonly="1"/>
                            </h2>
                            <small class="text-muted">
                                <field name="phone_b" widget="phone" readonly="1"/>
                                <span class="mx-1">·</span>
                                <field name="channel_type" readonly="1"/>
                                <span class="mx-1">·</span>
                                <field name="message_count" readonly="1"/> messages
                            </small>
                        </div>
                        <field name="partner_id" invisible="1"/>
                        <field name="phone_a" invisible="1"/>
                    </div>
                    <field name="message_ids" widget="connect_chat_thread"/>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
