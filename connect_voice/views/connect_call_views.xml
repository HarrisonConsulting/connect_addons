<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Call List View - Add voice agent column -->
    <record id="voice_call_list" model="ir.ui.view">
        <field name="name">voice_call_list</field>
        <field name="model">connect.call</field>
        <field name="inherit_id" ref="connect.connect_call_list"/>
        <field name="arch" type="xml">
            <field name="partner" position="after">
                <field name="voice_agent_id" optional="show" string="Voice Agent"/>
            </field>
        </field>
    </record>

    <!-- Call Form View - Add voice agent tab -->
    <record id="voice_call_form" model="ir.ui.view">
        <field name="name">voice_call_form</field>
        <field name="model">connect.call</field>
        <field name="inherit_id" ref="connect.connect_call_form"/>
        <field name="arch" type="xml">
            <page name="recording" position="before">
                <page name="voice_agent" string="Voice Agent" invisible="not voice_agent_id">
                    <group>
                        <group>
                            <field name="voice_recording_widget" nolabel="1"/>
                        </group>
                        <group>
                            <field name="voice_agent_id"/>
                            <field name="voice_conversation_id" string="Conversation ID"/>
                        </group>
                    </group>
                    <group>
                        <field name="voice_transcript" string="Transcript"/>
                    </group>
                </page>
            </page>
            <field name="summary" position="after">
                <field name="voice_summary" string="AI Summary" invisible="not voice_summary"/>
            </field>
        </field>
    </record>

    <!-- Call Search View - Add voice agent filter -->
    <record id="voice_call_search" model="ir.ui.view">
        <field name="name">voice_call_search</field>
        <field name="model">connect.call</field>
        <field name="inherit_id" ref="connect.connect_call_search"/>
        <field name="arch" type="xml">
            <search>
                <field name="partner" position="after">
                    <field name="voice_agent_id"/>
                </field>
                <filter name="by_partner" position="after">
                    <filter name="by_voice_agent" string="Voice Agent" context="{'group_by': 'voice_agent_id'}"/>
                </filter>
            </search>
        </field>
    </record>

</odoo>
