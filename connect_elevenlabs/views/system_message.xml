<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action that filters connect.audio to system-keyed entries. -->
    <record id="elevenlabs_system_message_action" model="ir.actions.act_window">
        <field name="name">System Messages</field>
        <field name="path">system-messages</field>
        <field name="res_model">connect.audio</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('system_key', '!=', False)]</field>
    </record>

    <menuitem
        id="elevenlabs_system_message_menu"
        name="System Messages"
        action="elevenlabs_system_message_action"
        parent="connect.connect_settings_menu"
        sequence="25"/>
</odoo>
