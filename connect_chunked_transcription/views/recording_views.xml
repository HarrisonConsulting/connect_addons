<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_recording_form_chunked" model="ir.ui.view">
        <field name="name">connect.recording.form.chunked</field>
        <field name="model">connect.recording</field>
        <field name="inherit_id" ref="connect.connect_recording_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Chunked Transcription" invisible="not chunked_job_id"
                       groups="connect_chunked_transcription.group_connect_chunked_user">
                    <field name="chunked_job_id" readonly="1"/>
                    <field name="is_chunked_transcription" invisible="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
