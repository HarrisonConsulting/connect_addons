<odoo>

    <!-- Call -->
    <record id="connect_call_user_rule" model="ir.rule">
        <field name="name">connect_call_user</field>
        <field name="model_id" ref="connect.model_connect_call"/>
        <field name="groups" eval="[(6, 0, [ref('connect.group_connect_user')])]"/>
        <field name="domain_force">['|', '|', '|', '|', ('caller_user', '=', user.id), ('called_users', '=', user.id), ('answered_user', '=', user.id), ('voicemail_box_id.member_ids', 'in', [user.id]), '&amp;', ('voicemail_box_id', '=', False), ('voicemail_url', '!=', False)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Voicemail Box: users see only boxes they belong to -->
    <record id="connect_voicemail_box_user_rule" model="ir.rule">
        <field name="name">connect_voicemail_box_user</field>
        <field name="model_id" ref="connect_hc_core.model_connect_voicemail_box"/>
        <field name="groups" eval="[(6, 0, [ref('connect.group_connect_user')])]"/>
        <field name="domain_force">[('member_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Conversation: all connect users can see all conversations -->
    <record id="connect_conversation_user_rule" model="ir.rule">
        <field name="name">connect_conversation_user</field>
        <field name="model_id" ref="connect_hc_core.model_connect_conversation"/>
        <field name="groups" eval="[(6, 0, [ref('connect.group_connect_user')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>


</odoo>
