<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="elevenlabs_call_list" model="ir.ui.view">
        <field name="name">elevenlabs_call_list</field>
        <field name="model">connect.call</field>
        <field name="inherit_id" ref="connect.view_connect_call_tree"/>
        <field name="arch" type="xml">
            <field name="partner" position="after">
                <field name="elevenlabs_agent" optional="show"/>
            </field>
        </field>
    </record>


    <record id="elevenlabs_call_form" model="ir.ui.view">
        <field name="name">elevenlabs_call_form</field>
        <field name="model">connect.call</field>
        <field name="inherit_id" ref="connect.view_connect_call_form"/>
        <field name="arch" type="xml">
            <page name="recording" position="attributes">
                <attribute name="invisible" add="not elevenlabs_recording_widget and not elevenlabs_transcript" separator=" and "/>
            </page>
            <page name="recording" position="inside">
                <field name="elevenlabs_recording_widget" nolabel="1"
                       invisible="not elevenlabs_recording_widget"/>
                <field name="elevenlabs_transcript" string="Agent Transcript"
                       nolabel="1" invisible="not elevenlabs_transcript"/>
            </page>
            <page name="recording" position="after">
                <page name="elevenlabs" string="Agent"
                      invisible="not elevenlabs_transcript">
                    <group>
                        <field name="elevenlabs_agent"/>
                    </group>
                </page>
            </page>
            <page name="details" position="inside">
                <group string="Agent reference" groups="base.group_no_one"
                       invisible="not elevenlabs_conversation_id">
                    <field name="elevenlabs_conversation_id"/>
                </group>
            </page>
            <field name="summary" position="after">
                <field name="elevenlabs_summary" string="Agent Summary"
                       invisible="not elevenlabs_summary"/>
            </field>
        </field>
    </record>

    <record id="elevenlabs_call_search" model="ir.ui.view">
        <field name="name">elevenlabs_call_search</field>
        <field name="model">connect.call</field>
        <field name="inherit_id" ref="connect.connect_call_search"/>
        <field name="arch" type="xml">
            <search>
                <field name="partner" position="after">
                    <field name="elevenlabs_agent"/>
                </field>
                <filter name="by_partner" position="after">
                    <filter name="by_elevenlabs_agent" context="{'group_by': 'elevenlabs_agent'}"/>
                </filter>
            </search>
        </field>
    </record>
</odoo>
