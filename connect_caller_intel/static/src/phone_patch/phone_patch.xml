<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="connect.phone" t-inherit-mode="extension">
        <xpath expr="//div[contains(@t-attf-class, 'o_phone_call_details')]/t[@t-else]" position="after">
            <CallerIntelCard t-if="state.inIncoming or state.inCall" phoneNumber="state.callPhoneNumber"/>
        </xpath>
    </t>
</templates>
