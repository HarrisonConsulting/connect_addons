<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

  <t t-name="connect_hc_core.AudioRecorderField">
    <div class="o_connect_audio_recorder">
      <div class="o_connect_audio_recorder_input"
           t-if="state.devicesLoaded">
        <label class="form-label mb-1" for="connect_audio_recorder_device">
          Microphone
        </label>
        <div class="o_connect_audio_recorder_input_row">
          <select id="connect_audio_recorder_device"
                  class="form-select form-select-sm"
                  t-att-value="selectedDeviceId"
                  t-on-change="onMicrophoneChange">
            <option t-foreach="microphoneOptions"
                    t-as="device"
                    t-key="device.id"
                    t-att-value="device.id">
              <t t-esc="device.label"/>
            </option>
          </select>
          <button type="button"
                  class="btn btn-outline-secondary btn-sm"
                  t-on-click="onRefreshDevices">
            <i class="fa fa-refresh"/>
          </button>
        </div>
      </div>
      <div class="o_connect_audio_recorder_controls">
        <button t-if="state.status === 'idle' and !hasRecording"
                type="button"
                class="btn btn-primary btn-sm"
                t-on-click="onRecord">
          <i class="fa fa-microphone me-1"/>Record
        </button>
        <button t-if="state.status === 'recording'"
                type="button"
                class="btn btn-danger btn-sm"
                t-on-click="onStop">
          <i class="fa fa-stop me-1"/>Stop
          <span class="ms-2" t-esc="formatDuration(state.durationMs)"/>
        </button>
        <span t-if="state.status === 'encoding'" class="text-muted">
          <i class="fa fa-spinner fa-spin me-1"/>Encoding…
        </span>
        <button t-if="state.status === 'idle' and hasRecording"
                type="button"
                class="btn btn-secondary btn-sm"
                t-on-click="onRecord">
          <i class="fa fa-microphone me-1"/>Re-record
        </button>
        <button t-if="state.status === 'idle' and hasRecording"
                type="button"
                class="btn btn-link btn-sm text-danger"
                t-on-click="onClear">
          <i class="fa fa-trash"/>
        </button>
      </div>
      <audio t-if="state.previewUrl"
             controls="controls"
             preload="auto"
             t-att-src="state.previewUrl"
             class="mt-2 w-100"/>
      <div t-if="state.status === 'error'" class="alert alert-warning mt-2 mb-0 py-2">
        <i class="fa fa-exclamation-triangle me-1"/>
        <span t-esc="state.error"/>
      </div>
    </div>
  </t>

</templates>
