<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connect_channel_tree" model="ir.ui.view">
        <field name="name">connect.channel.tree</field>
        <field name="model">connect.channel</field>
        <field name="arch" type="xml">
            <list default_order="id desc" decoration-danger="status == 'failed'">
                <field name="caller_number" string="From"/>
                <field name="called_number" string="To"/>
                <field name="partner"/>
                <field name="technical_direction" string="Direction"/>
                <field name="status"/>
                <field name="duration_human" string="Duration"/>
                <field name="call_type" optional="hide"/>
                <field name="caller" optional="hide"/>
                <field name="called" optional="hide"/>
                <field name="caller_pbx_user" optional="hide"/>
                <field name="called_pbx_user" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_connect_channel_form" model="ir.ui.view">
        <field name="name">connect.channel.form</field>
        <field name="model">connect.channel</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="badge" invisible="not status"/>
                    <field name="technical_direction" string="Direction" widget="badge"
                           invisible="not technical_direction"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="call"/>
                            <field name="caller_number" widget="phone"/>
                            <field name="called_number" widget="phone"/>
                            <field name="partner" invisible="not partner"/>
                        </group>
                        <group>
                            <field name="caller_user" invisible="not caller_user"/>
                            <field name="called_user" invisible="not called_user"/>
                            <field name="caller_pbx_user" invisible="not caller_pbx_user"/>
                            <field name="called_pbx_user" invisible="not called_pbx_user"/>
                            <field name="call_type"/>
                            <field name="duration_human" string="Duration"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="details" string="Details">
                            <group>
                                <group string="As dialed">
                                    <field name="caller"/>
                                    <field name="called"/>
                                    <field name="to" invisible="not to"/>
                                    <field name="parent_channel" invisible="not parent_channel"/>
                                </group>
                                <group string="Duration">
                                    <field name="duration" string="Seconds"/>
                                    <field name="duration_minutes" string="Minutes"/>
                                    <field name="duration_billing" string="Bill minutes"/>
                                    <field name="recording_state"/>
                                </group>
                            </group>
                        </page>
                        <page name="reference" string="Reference" groups="base.group_no_one">
                            <group>
                                <field name="sid"/>
                                <field name="parent_sid"/>
                                <field name="recording_control_ref" invisible="not recording_control_ref"/>
                                <field name="recording_control_path" invisible="not recording_control_path"/>
                                <field name="recording_control_error" invisible="not recording_control_error"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_connect_channel_search" model="ir.ui.view">
        <field name="name">connect.channel.search</field>
        <field name="model">connect.channel</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner"/>
                <field name="caller_number"/>
                <field name="called_number"/>
                <field name="caller"/>
                <field name="called"/>
                <filter name="failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <group>
                    <filter name="by_partner" string="Contact" context="{'group_by': 'partner'}"/>
                    <filter name="by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="by_direction" string="Direction" context="{'group_by': 'technical_direction'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_connect_channel" model="ir.actions.act_window">
        <field name="name">Channels</field>
        <field name="res_model">connect.channel</field>
        <field name="view_mode">list,form</field>
        <field name="path">connect-channel</field>
    </record>

    <menuitem id="menu_connect_channels"
              name="Channels"
              parent="menu_connect_calls"
              action="action_connect_channel"
              groups="connect.group_admin"
              sequence="90"/>
</odoo>
