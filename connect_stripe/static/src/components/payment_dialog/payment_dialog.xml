<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="connect_stripe.payment_dialog" owl="1">
        <Dialog title="'Take Payment'">
            <t t-if="state.phase === 'setup'">
                <div class="mb-3 small text-muted">
                    Customer: <strong><t t-out="state.partnerName or 'unknown — payment will not auto-reconcile'"/></strong>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Amount</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input
                            type="number"
                            class="form-control"
                            min="0.01"
                            step="0.01"
                            placeholder="0.00"
                            t-model="state.amount"
                        />
                    </div>
                    <t t-if="state.amountError">
                        <div class="text-danger small mt-1"><t t-out="state.amountError"/></div>
                    </t>
                </div>
                <div class="alert alert-info py-2 small mb-3">
                    <strong>Say to the customer:</strong> "I'm going to take your payment now. In a moment you'll hear a prompt — please type your card number on your phone keypad, then expiry, then the CVC."
                </div>
                <div class="d-flex gap-2 justify-content-end">
                    <button class="btn btn-secondary" t-on-click="() => props.close()">Cancel</button>
                    <button class="btn btn-primary" t-on-click="_initiate">Charge</button>
                </div>
            </t>
            <t t-elif="state.phase === 'capturing'">
                <div class="text-center py-3">
                    <h6 class="mb-3">Waiting for customer to enter card…</h6>
                    <div class="connect-stripe-card-dots mb-2">
                        <span class="connect-stripe-dot-group">
                            <t t-if="state.maskedCard">
                                ●●●● ●●●● ●●●● <t t-out="state.maskedCard"/>
                            </t>
                            <t t-else="">
                                ●●●● ●●●● ●●●● ●●●●
                            </t>
                        </span>
                    </div>
                    <div class="text-muted small mb-3">Expiry: ●● / ●● &#160; CVC: ●●●</div>
                    <div class="alert alert-info py-2 small">
                        Agent: you may hear beeps — this is normal. The customer's keypad is masked.
                    </div>
                    <button class="btn btn-outline-danger btn-sm" t-on-click="_cancel" t-att-disabled="state.cancelling">
                        <t t-if="state.cancelling">Cancelling…</t>
                        <t t-else="">Cancel payment</t>
                    </button>
                </div>
            </t>
            <t t-elif="state.phase === 'processing'">
                <div class="text-center py-3">
                    <div class="spinner-border text-primary mb-3" role="status">
                        <span class="visually-hidden">Loading…</span>
                    </div>
                    <div>Processing payment…</div>
                    <t t-if="state.maskedCard">
                        <div class="text-muted small mt-2">
                            <t t-out="state.cardType"/> ****<t t-out="state.maskedCard"/>
                        </div>
                    </t>
                </div>
            </t>
            <t t-elif="state.phase === 'complete'">
                <div class="text-center py-3">
                    <i class="fa fa-check-circle text-success fa-3x mb-3" title="Payment complete"/>
                    <div class="fw-bold mb-1">
                        <t t-out="state.cardType"/> ****<t t-out="state.maskedCard"/>
                    </div>
                    <div class="text-success mb-3">Payment complete</div>
                    <button class="btn btn-primary" t-on-click="() => props.close()">Close</button>
                </div>
            </t>
            <t t-elif="state.phase === 'cancelled'">
                <div class="text-center py-3">
                    <i class="fa fa-ban text-secondary fa-3x mb-3" title="Cancelled"/>
                    <div class="text-secondary mb-3">Payment cancelled. The customer has been returned to the call.</div>
                    <button class="btn btn-secondary" t-on-click="() => props.close()">Close</button>
                </div>
            </t>
            <t t-elif="state.phase === 'failed'">
                <div class="text-center py-3">
                    <i class="fa fa-times-circle text-danger fa-3x mb-3" title="Payment failed"/>
                    <div class="text-danger mb-3"><t t-out="state.errorMessage"/></div>
                    <div class="d-flex gap-2 justify-content-center">
                        <button class="btn btn-secondary" t-on-click="() => props.close()">Close</button>
                        <button class="btn btn-warning" t-on-click="_retry">Retry</button>
                    </div>
                </div>
            </t>
        </Dialog>
    </t>

</templates>
