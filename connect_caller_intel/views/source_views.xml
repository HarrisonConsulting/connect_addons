<odoo>
    <record id="view_caller_source_list" model="ir.ui.view">
        <field name="name">connect.caller.source.list</field>
        <field name="model">connect.caller.source</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="tier"/>
                <field name="cost_class"/>
                <field name="enabled"/>
                <field name="adapter_available"/>
            </list>
        </field>
    </record>

    <record id="view_caller_source_form" model="ir.ui.view">
        <field name="name">connect.caller.source.form</field>
        <field name="model">connect.caller.source</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_enable" type="object" string="Enable" class="btn-primary"
                            invisible="enabled or requires_purpose_ack" groups="connect.group_admin"
                            confirm="This source may charge per use. Enabling records your name and the time as acceptance of the cost shown in the cost note. Turning it off stops new charges; charges already incurred are not refunded."/>
                    <button name="action_enable_with_purpose" type="object" string="Enable" class="btn-primary"
                            invisible="enabled or not requires_purpose_ack" groups="connect.group_admin"
                            confirm="This source returns personal data. It may be used only to identify a caller. Never use it to decide credit, employment, insurance, housing or any other eligibility. Enabling records your name and the time as acceptance of this purpose and of the cost note."/>
                    <button name="action_disable" type="object" string="Disable"
                            invisible="not enabled" groups="connect.group_admin"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="tier"/>
                            <field name="cost_class"/>
                            <field name="enabled"/>
                            <field name="adapter_available"/>
                        </group>
                        <group>
                            <field name="credential_param"/>
                            <field name="ttl_hours"/>
                            <field name="cost_acknowledged_by"/>
                            <field name="cost_acknowledged_at"/>
                            <field name="attribution"/>
                            <field name="requires_purpose_ack"/>
                            <field name="purpose_acknowledged_by"/>
                            <field name="purpose_acknowledged_at"/>
                        </group>
                    </group>
                    <group string="Permitted purpose" invisible="not requires_purpose_ack">
                        <field name="purpose_note" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Cost">
                        <field name="cost_note" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Clearing a mark">
                        <field name="clearing_url"/>
                        <field name="clearing_note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_caller_source" model="ir.actions.act_window">
        <field name="name">Caller Intel Sources</field>
        <field name="res_model">connect.caller.source</field>
        <field name="path">caller-intel-sources</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
